{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "85b38777b5da4901842c0197b8a5a9e5",
    "m_Title": "GRASS WIND DETAIL SHADER",
    "m_Content": "This is a full-featured grass blade shader intended for use with the included grass blade meshes.\n\nTo make the grass render as fast as possible, the grass meshes have only 12 vertices, 10 triangles, and no UV coordinates or vertex colors. The shader doesn't sample any textures at all and most of the math is performed in the vertex shader.",
